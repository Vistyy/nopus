{
  "name": "@syzom/nopus",
  "version": "1.1.0",
  "license": "MIT",
  "description": "Uses deterministic prose checks to flag overly complex coding-agent responses and ask for one clearer rewrite.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./plugin/dist/pi-extension.mjs"
    ],
    "skills": [
      "./plugin/skills"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vistyy/nopus.git"
  },
  "bugs": {
    "url": "https://github.com/Vistyy/nopus/issues"
  },
  "homepage": "https://github.com/Vistyy/nopus#readme",
  "files": [
    ".agents/plugins/marketplace.json",
    ".claude-plugin/marketplace.json",
    "data/licenses/",
    "plugin/",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm build",
    "import:data": "tsx scripts/import-data.ts",
    "check:data": "tsx scripts/check-data.ts",
    "check": "pnpm check:data && tsc --noEmit && pnpm build && node --import tsx --test 'tests/**/*.test.ts'",
    "evaluate:parity": "tsx evaluation/src/run.ts",
    "evaluate:review": "tsx evaluation/src/build-label-review.ts",
    "evaluate:pi-corpus": "tsx evaluation/src/pi-corpus.ts",
    "evaluate:pi-review": "tsx evaluation/src/build-pi-corpus-review.ts",
    "evaluate:rewrite-model": "tsx evaluation/src/rewrite-model-eval.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.232",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@openai/codex": "0.147.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wink-eng-lite-web-model": "1.8.1",
    "wink-nlp": "2.4.0",
    "yaml": "2.8.1"
  }
}
